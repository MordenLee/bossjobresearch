{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job-search review_policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "hard_constraints",
    "soft_preferences",
    "exclusions",
    "tradeoffs",
    "priority_rules",
    "verification_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "quote"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "user_instruction",
                  "candidate_evidence",
                  "confirmed_preference"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "soft_preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "quote"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "user_instruction",
                  "candidate_evidence",
                  "confirmed_preference"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "quote"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "user_instruction",
                  "candidate_evidence",
                  "confirmed_preference"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source",
          "may_relax_rule_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "quote"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "user_instruction",
                  "candidate_evidence",
                  "confirmed_preference"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "may_relax_rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "priority_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "quote"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "user_instruction",
                  "candidate_evidence",
                  "confirmed_preference"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "verification_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "quote"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "user_instruction",
                  "candidate_evidence",
                  "confirmed_preference"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  },
  "$comment": "跨数组 ID 唯一性和 tradeoff 只引用软偏好由 policy.py 验证。"
}
